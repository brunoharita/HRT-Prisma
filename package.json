{
  "name": "prisma-talent-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:ia": "pnpm run build && node scripts/start-prisma-ia-local.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "lint": "node scripts/lint.mjs",
    "check:foundation": "node scripts/check-foundation.mjs",
    "generate:prisma-context": "node scripts/generate-prisma-context.mjs",
    "check:prisma-context": "node scripts/check-prisma-context.mjs",
    "knowledge:prepare": "pnpm run build && node scripts/prepare-knowledge-source.mjs",
    "test": "pnpm run build && node scripts/run-tests.mjs",
    "test:person-flow": "pnpm run build && node scripts/run-tests.mjs --suite person-flow",
    "test:tooling": "node --test tests/tooling/validationRunner.test.mjs",
    "validate:person-flow": "node scripts/validate-person-flow.mjs",
    "test:golden": "pnpm run build && node dist/tests/golden/runner.js",
    "benchmark:m56": "node scripts/benchmark-m56.mjs",
    "benchmark:linkedin": "pnpm run build && node scripts/evaluate-linkedin-pdf.mjs",
    "parser:ia:local": "pnpm run build && node scripts/parser-ia-service.mjs --serve",
    "probe:paddle": "pnpm run build && node scripts/probe-paddle-runtime.mjs",
    "demo": "pnpm run build && node dist/src/cli.js demo",
    "audit:dependencies": "pnpm audit --prod --audit-level high",
    "validate": "pnpm run lint && pnpm run check:foundation && pnpm run check:prisma-context && pnpm run typecheck && pnpm run typecheck:web && pnpm run build:web && pnpm run test && pnpm run test:golden && pnpm run demo"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@supabase/supabase-js": "2.112.3",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "antd": "6.6.1",
    "csv-parse": "7.0.2",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}
