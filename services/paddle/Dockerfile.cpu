FROM python:3.12-slim-bookworm

ARG PADDLEPADDLE_VERSION=3.2.0
ARG PADDLEOCR_VERSION=3.7.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PADDLE_PDX_CACHE_HOME=/var/cache/paddlex

RUN apt-get update \
    && apt-get install --no-install-recommends -y libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
      "paddlepaddle==${PADDLEPADDLE_VERSION}" \
      --index-url https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && python -m pip install --no-cache-dir "paddleocr[doc-parser]==${PADDLEOCR_VERSION}" \
    && paddlex --install serving

RUN useradd --create-home --uid 10001 paddle \
    && mkdir -p /var/cache/paddlex \
    && chown -R paddle:paddle /var/cache/paddlex

USER paddle
EXPOSE 8080

ENTRYPOINT ["paddlex", "--serve"]
CMD ["--pipeline", "PP-StructureV3", "--device", "cpu", "--host", "0.0.0.0", "--port", "8080"]
